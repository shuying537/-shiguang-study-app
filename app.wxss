page{background:#f7f7fc;color:#282438;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}
/* 普通导入与 AI 计划共用的预览和编辑样式 */
.import-area{width:100%;height:380rpx;padding:24rpx;background:var(--bg);border:2rpx solid var(--line);border-radius:20rpx;line-height:1.7;margin-bottom:20rpx}
.parse-row{gap:20rpx}
.screen .parse-btn{flex:0 0 auto;margin:0;padding:0 34rpx;line-height:72rpx;font-size:26rpx;border-radius:16rpx}
.preview-section{margin-top:28rpx}
.screen .preview-note{margin:0 0 10rpx}
.screen .preview-card{padding:10rpx 28rpx}
.preview-row{padding:22rpx 0;border-bottom:1rpx solid var(--line)}
.preview-row:last-child{border-bottom:0}
.preview-title{flex:1;min-width:0;margin-right:16rpx;overflow-wrap:anywhere;font-size:27rpx;font-weight:600}
.row-tools{gap:28rpx;flex-shrink:0;justify-content:flex-end;margin-top:12rpx}
.preview-edit{padding:6rpx 0}
.edit-input{width:100%;margin-bottom:12rpx}
.edit-line{display:flex;gap:12rpx;margin-bottom:12rpx}
.edit-line>picker,.edit-line>.wx-picker-wrap{flex:1;min-width:0}
.edit-duration{display:flex;gap:16rpx;align-items:center;margin:12rpx 0}
.minutes-input{flex:1;min-width:0}
.edit-line .picker-box{flex:1;min-width:0;min-height:72rpx;padding:16rpx;font-size:24rpx}
.edit-line .time-box{flex:0 0 140rpx;text-align:center}
.edit-actions{justify-content:flex-end;gap:28rpx}
.badge.success{color:#49977A;background:#EAF7F1}
.badge.warning{color:#B98235;background:#FFF4DF}
.badge.muted{color:var(--muted);background:var(--bg)}
.badge.danger{color:#D66A6A;background:#FFF0F0}
view,text,button,input,textarea{box-sizing:border-box}button{font-size:28rpx;margin:0;border-radius:20rpx}button::after{border:0}button[disabled]{opacity:.45}button:active{opacity:.8}
.screen{--bg:#f7f7fc;--card:#fff;--ink:#282438;--muted:#9995ac;--line:#eeedf5;--soft:#f2f0fc;--accent:#7061d8;background:var(--bg);color:var(--ink);min-height:100vh;padding:36rpx 32rpx 80rpx}
.screen.dark{--bg:#191823;--card:#252433;--ink:#edeaf8;--muted:#aaa5bc;--line:#373444;--soft:#323046;--accent:#ad9aff}
.eyebrow{font-size:22rpx;letter-spacing:4rpx;color:var(--muted);font-weight:600}.title{font-size:46rpx;line-height:1.45;font-weight:700;letter-spacing:-1rpx;margin:12rpx 0}.subtitle{color:var(--muted);line-height:1.7;font-size:26rpx}.row{display:flex;align-items:center}.between{justify-content:space-between}.gap{gap:16rpx}.muted{color:var(--muted)}.small{font-size:24rpx}.strong{font-weight:600}.section-head{display:flex;justify-content:space-between;align-items:center;margin:42rpx 0 22rpx;font-size:32rpx;font-weight:650}.link{color:var(--accent);font-size:24rpx;font-weight:500}.card{background:var(--card);border-radius:28rpx;padding:30rpx;margin-bottom:20rpx;box-shadow:0 6rpx 24rpx rgba(38,30,76,.025)}.divider{height:1rpx;background:var(--line);margin:24rpx 0}.pill{background:var(--soft);color:var(--accent);font-size:22rpx;padding:8rpx 16rpx;border-radius:50rpx}.dot{width:14rpx;height:14rpx;flex-shrink:0;border-radius:50%;margin-right:12rpx}.primary{background:#7061d8;color:#fff;font-weight:600;line-height:88rpx}.secondary{background:var(--soft);color:var(--accent);line-height:80rpx}.danger{background:#fff0f0;color:#d66a6a;line-height:80rpx}.plain-btn{background:transparent;padding:0;line-height:1.6;color:var(--accent);font-size:24rpx}.empty{text-align:center;padding:48rpx 20rpx;line-height:1.8}.empty-icon{font-size:60rpx;color:var(--accent);margin-bottom:16rpx}.empty-title{font-size:30rpx;font-weight:600;margin-bottom:8rpx}.empty .primary,.empty .secondary{margin-top:24rpx}.badge{font-size:21rpx;padding:6rpx 12rpx;border-radius:10rpx;background:var(--soft);color:var(--accent)}.danger-text{color:#d97777}.field{margin:24rpx 0}.field-label{font-size:25rpx;font-weight:600;margin-bottom:14rpx}.input,.picker-box,.textarea{background:var(--bg);border:2rpx solid var(--line);border-radius:18rpx;padding:22rpx 24rpx;min-height:88rpx;color:var(--ink);font-size:28rpx}.textarea{height:180rpx;width:100%;line-height:1.65}.hint{font-size:23rpx;color:var(--muted);line-height:1.7;margin-top:10rpx}.chips{display:flex;flex-wrap:wrap;gap:14rpx;margin:22rpx 0}.chip{padding:14rpx 22rpx;background:var(--card);border:2rpx solid var(--line);border-radius:18rpx;color:var(--muted);font-size:25rpx}.chip.active{background:var(--soft);color:var(--accent);border-color:var(--accent)}.footer-actions{margin-top:36rpx;display:flex;gap:20rpx}.footer-actions button{flex:1}.tab-switch{display:flex;background:var(--card);padding:8rpx;border-radius:20rpx;margin:26rpx 0}.tab-item{flex:1;text-align:center;padding:16rpx 0;font-size:25rpx;color:var(--muted);border-radius:14rpx}.tab-item.active{background:var(--soft);color:var(--accent);font-weight:600}.note-box{background:var(--soft);padding:22rpx 26rpx;border-radius:20rpx;line-height:1.8;color:var(--muted);font-size:24rpx;margin:22rpx 0}.fab{position:fixed;bottom:40rpx;right:32rpx;background:#7061d8;color:#fff;border-radius:50rpx;padding:0 32rpx;line-height:94rpx;box-shadow:0 12rpx 36rpx rgba(112,97,216,.3);font-weight:600;z-index:5}.form-page{padding-bottom:80rpx}.metrics{display:flex;gap:18rpx}.metric{flex:1;background:var(--card);border-radius:24rpx;padding:24rpx 18rpx;text-align:center}.metric-number{font-size:38rpx;font-weight:700;margin-bottom:8rpx}.metric-label{font-size:22rpx;color:var(--muted)}.list-row{padding:24rpx 0;border-bottom:1rpx solid var(--line)}.list-row:last-child{border-bottom:0}.chevron{color:var(--muted);font-size:34rpx}.tag{display:inline-block;padding:8rpx 12rpx;border-radius:12rpx;background:var(--bg);font-size:22rpx;color:var(--muted)}
