.mini-add{background:var(--soft);color:var(--accent);font-size:40rpx;width:76rpx;height:76rpx;line-height:70rpx;padding:0;border-radius:22rpx}.tab-count{font-size:20rpx;opacity:.7}.subject-scroll{white-space:nowrap;margin-bottom:24rpx}.subject-inline{display:inline-flex;gap:14rpx}.filter-chip{background:var(--card);color:var(--muted);font-size:24rpx;border:1rpx solid var(--line);padding:12rpx 22rpx;border-radius:30rpx}.filter-chip.selected{background:var(--soft);color:var(--accent);border-color:var(--accent)}.task-hint{margin-bottom:20rpx}.full-task{padding:28rpx}.full-task.done{opacity:.65}.check-circle{width:42rpx;height:42rpx;line-height:38rpx;border:2rpx solid var(--line);border-radius:50%;color:var(--muted);text-align:center;flex-shrink:0;align-self:flex-start;margin-top:2rpx}.check-circle.checked{background:var(--accent);border-color:var(--accent);color:#fff}.task-main{flex:1;min-width:0}.task-title{font-size:29rpx;font-weight:600;max-width:380rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.task-meta{font-size:23rpx;color:var(--muted);margin-top:18rpx}.task-footer{margin-top:24rpx;margin-left:58rpx}.subject-tag{background:var(--bg);border-radius:8rpx;padding:5rpx 10rpx}.overdue-actions{display:flex;border-top:1rpx solid var(--line);margin-top:24rpx;padding-top:18rpx;gap:16rpx}.overdue-actions button{flex:1;background:var(--bg);font-size:24rpx;line-height:64rpx;color:var(--muted);border-radius:14rpx}.end-note{text-align:center;padding:30rpx}
.task-page .mini-add{min-width:0;max-width:76rpx;margin:0;flex:0 0 76rpx}.task-page .check-circle{display:block;min-width:0;max-width:42rpx;flex:0 0 42rpx;height:42rpx;margin:2rpx 0 0;padding:0;font-size:25rpx;background:var(--card)}.task-page .check-circle.checked{background:var(--accent);color:#fff}.task-page .task-meta{display:flex;flex-wrap:wrap;gap:12rpx;align-items:center}.task-page .task-footer{gap:14rpx}.task-footer .small{flex:1;min-width:0;font-size:22rpx}.task-footer .badge{flex-shrink:0}.task-page .overdue-actions button{width:auto;min-width:0;margin:0}.task-page .task-title{max-width:100%;white-space:normal;word-break:break-all}.task-page .tab-item{padding-left:0;padding-right:0;font-size:23rpx}
