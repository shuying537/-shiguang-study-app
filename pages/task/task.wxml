<view class="screen {{theme}} form-page">
 <view class="eyebrow">MY STUDY PLAN</view><view class="title">{{editing?'任务详情':'安排一件小事'}}</view><view class="subtitle">明确哪天做，也给自己留出完成的时间。</view>
 <view class="card form-card">
  <view class="field"><view class="field-label">任务名称</view><input class="input" maxlength="60" placeholder="例如：完成数学第二章练习" value="{{title}}" data-field="title" bindinput="input"/></view>
  <view class="field"><view class="field-label">科目</view><picker mode="selector" range="{{subjects}}" range-key="name" value="{{subjectIndex}}" bindchange="subjectChange"><view class="picker-box row between"><text>{{subjects[subjectIndex].name}}</text><text class="chevron">⌄</text></view></picker><text class="hint link" bindtap="createSubject">＋ 新建科目</text></view>
  <view class="field"><view class="field-label">计划哪天做</view><picker mode="date" value="{{plannedDate}}" bindchange="plannedChange"><view class="picker-box">{{plannedDate || '选择计划日期'}}</view></picker><view class="hint">安排在今天的任务，会出现在首页。</view></view>
  <view class="field"><view class="field-label">最晚完成时间</view><picker mode="date" value="{{deadlineDate}}" start="{{plannedDate}}" bindchange="datePartChange"><view class="picker-box">{{deadlineDate}}</view></picker><picker mode="time" value="{{deadlineTime}}" bindchange="timePartChange"><view class="picker-box time-box">{{deadlineTime}}</view></picker></view>
  <view class="field"><view class="field-label">预计时长 <text class="small muted">· 选填</text></view><input class="input" type="number" maxlength="4" placeholder="分钟，例如 30（5 分钟为步长）" value="{{estimatedMinutes}}" data-field="estimatedMinutes" bindinput="input"/><view class="hint">预计时间不计入实际学习时长。</view></view>
  <view class="field"><view class="field-label">备注 <text class="small muted">· 选填</text></view><textarea class="textarea" maxlength="200" placeholder="写下学习范围或完成标准…" value="{{note}}" data-field="note" bindinput="input"></textarea></view>
  <view class="field"><view class="row between"><view><view class="field-label no-margin">任务提醒</view><view class="hint">仅保存偏好，当前不发送后台通知。</view></view><switch checked="{{reminder}}" color="#7061D8" bindchange="reminderChange"/></view></view>
 </view>
 <view wx:if="{{editing}}" class="card task-status-card">
  <view class="row between"><view><view class="strong">当前状态</view><view class="hint">已投入 {{totalText}}</view></view><text class="badge">{{status}}</text></view>
  <view class="status-actions"><button wx:if="{{!abandoned}}" bindtap="toggle">{{completed?'取消完成':'标记完成'}}</button><button wx:else bindtap="restore">恢复旧版任务</button></view>
  <view class="hint">完成任务不会自动增加学习时长。</view>
 </view>
 <view wx:if="{{records.length}}" class="card"><view class="field-label">关联学习记录</view><view wx:for="{{records}}" wx:key="id" class="list-row row between" data-id="{{item.id}}" bindtap="editRecord"><view><view class="strong">{{item.date}}</view><view class="hint">{{item.note || '专注学习'}}</view></view><text class="small muted">{{item.durationText}} ›</text></view></view>
 <view class="footer-actions"><button wx:if="{{editing}}" class="danger" bindtap="remove">删除任务</button><button class="primary" disabled="{{loadError}}" bindtap="save">{{editing?'保存修改':'保存任务'}}</button></view>
 <button wx:if="{{editing}}" class="plain-btn add-record-btn" bindtap="addRecord">＋ 给这个任务记一笔</button>
</view>


