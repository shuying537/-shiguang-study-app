.chips{display:flex;flex-wrap:wrap;gap:16rpx}
.subject-chip{background:var(--bg);border:2rpx solid var(--line);color:var(--muted);font-size:24rpx;padding:12rpx 22rpx;border-radius:28rpx}
.subject-chip.selected{background:var(--soft);border-color:var(--accent);color:var(--accent);font-weight:600}
.goal-row{padding:26rpx}
.goal-main{flex:1;min-width:0;margin-right:20rpx}
.goal-title{font-size:34rpx;font-weight:600;margin-bottom:8rpx}
.goal-days{font-size:44rpx;font-weight:700;color:var(--accent);flex-shrink:0}
.goal-days.muted{color:var(--muted)}
.goal-actions{justify-content:flex-end;gap:28rpx;margin-top:16rpx}
