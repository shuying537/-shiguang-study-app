.import-area{width:100%;height:420rpx;padding:24rpx;background:var(--bg);border:2rpx solid var(--line);border-radius:20rpx;line-height:1.7;margin-bottom:24rpx}.preview-section{margin-top:28rpx}.preview-card{padding:10rpx 28rpx}.preview-row{padding:22rpx 0;border-bottom:1rpx solid var(--line)}.preview-row:last-child{border-bottom:0}.preview-title{max-width:460rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:27rpx}.warning{color:#B98235;background:#FFF4DF}.success{color:#49977A;background:#EAF7F1}
