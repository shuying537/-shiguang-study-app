.import-area{width:100%;height:380rpx;padding:24rpx;background:var(--bg);border:2rpx solid var(--line);border-radius:20rpx;line-height:1.7;margin-bottom:20rpx}
.parse-row{gap:20rpx}
.parse-btn{flex:0 0 auto;margin:0;padding:0 34rpx;line-height:72rpx;font-size:26rpx;border-radius:16rpx}
.preview-section{margin-top:28rpx}
.preview-note{margin:0 0 10rpx}
.preview-card{padding:10rpx 28rpx}
.preview-row{padding:22rpx 0;border-bottom:1rpx solid var(--line)}
.preview-row:last-child{border-bottom:0}
.preview-title{flex:1;min-width:0;margin-right:16rpx;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:27rpx;font-weight:600}
.row-tools{gap:16rpx;flex-shrink:0}
.preview-edit{padding:6rpx 0}
.edit-input{width:100%;margin-bottom:12rpx}
.edit-line{display:flex;gap:12rpx;margin-bottom:12rpx}
.edit-line .picker-box{flex:1;min-width:0;min-height:72rpx;padding:16rpx;font-size:24rpx}
.edit-line .time-box{flex:0 0 140rpx;text-align:center}
.edit-actions{justify-content:flex-end;gap:28rpx}
.badge.success{color:#49977A;background:#EAF7F1}
.badge.warning{color:#B98235;background:#FFF4DF}
.badge.muted{color:var(--muted);background:var(--bg)}
.badge.danger{color:#D66A6A;background:#FFF0F0}
.option-row{padding:6rpx 4rpx 26rpx}
