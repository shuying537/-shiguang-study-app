.home-page{padding-bottom:64rpx}.home-header .eyebrow{letter-spacing:1rpx;font-size:23rpx}.home-header .title{font-size:39rpx;margin-bottom:0}.home-header .plain-btn{flex-shrink:0;margin-left:14rpx}
.hero{position:relative;overflow:hidden;background:#7061d8;color:#fff;border-radius:30rpx;padding:28rpx 32rpx;margin:26rpx 0 30rpx}.hero:after{content:"";position:absolute;right:-24rpx;top:32rpx;width:190rpx;height:190rpx;border:28rpx solid rgba(255,255,255,.07);border-radius:50%;pointer-events:none}.hero-label{font-size:26rpx;opacity:.8}.hero-star{font-size:32rpx;opacity:.6}.hero-total{font-size:60rpx;font-weight:650;margin:16rpx 0 22rpx;letter-spacing:-1rpx}.hero-bottom{font-size:24rpx;padding-top:20rpx;border-top:1rpx solid rgba(255,255,255,.2);position:relative;z-index:1}.hero-link{font-size:24rpx}.section-head{font-size:31rpx;margin-top:32rpx}
.quick-card{padding:6rpx 24rpx 0}.quick-subject-row{display:flex;align-items:center;min-height:112rpx;border-bottom:1rpx solid var(--line)}.quick-subject-meta{display:flex;align-items:center;flex:1 1 0%;min-width:0;overflow:hidden;margin-right:14rpx}.quick-subject-name{flex:1 1 0%;min-width:0;font-size:28rpx;font-weight:600}.quick-subject-name text{display:block;flex:1;min-width:0;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.quick-total{flex:0 0 84rpx;width:84rpx;text-align:right;font-size:24rpx;color:var(--muted)}.quick-actions{display:flex;align-items:center;flex:0 0 284rpx;width:284rpx;min-width:0}
.home-page .quick-actions .quick-step{display:block;box-sizing:border-box;flex:0 0 88rpx;width:88rpx;min-width:0;max-width:88rpx;margin:0 10rpx 0 0;padding:0;height:68rpx;line-height:68rpx;border-radius:15rpx;font-size:24rpx;font-weight:600;background:var(--soft);color:var(--ink)}.home-page .quick-actions .quick-step:last-child{margin-right:0;color:var(--accent)}.home-page .quick-actions .quick-step-minus{color:var(--muted)}.home-page .quick-actions .quick-step[disabled]{background:var(--bg);color:var(--muted);opacity:.5}
.quick-footer{min-height:88rpx;gap:12rpx}.quick-feedback{flex:1;min-width:0;font-size:22rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--muted)}.quick-footer .plain-btn{flex-shrink:0;line-height:68rpx}.first-hint{margin:-4rpx 10rpx 26rpx}.empty-plan{padding:26rpx}.empty-plan .secondary{display:inline-block;width:auto;margin-top:22rpx;padding:0 28rpx;font-size:25rpx;line-height:68rpx}
.today-task{display:flex;align-items:center;padding:24rpx;gap:18rpx}.today-task-body{flex:1;min-width:0}.today-task-title{font-size:28rpx;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.home-page .task-check{flex:0 0 44rpx;width:44rpx;min-width:0;max-width:44rpx;height:44rpx;line-height:40rpx;margin:0;padding:0;border:2rpx solid var(--line);border-radius:50%;background:var(--card);color:var(--accent);font-size:26rpx}.home-page .task-check.checked{background:var(--accent);border-color:var(--accent);color:#fff}.task-done .today-task-title{color:var(--muted);text-decoration:line-through}.today-task .badge{flex-shrink:0}.expand-tasks{display:block;width:100%;text-align:center;line-height:60rpx}.pending-note{margin:18rpx 0}.home-bottom{margin:34rpx 0 10rpx;gap:12rpx}.home-bottom .small{font-size:22rpx}.home-bottom .link{flex-shrink:0}
