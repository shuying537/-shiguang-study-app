<view class="screen {{theme}} ai-plan-page">
 <view class="eyebrow">PLAN WITH YOUR AI</view>
 <view class="title">准备学习计划</view>
 <view class="subtitle">填写目标后生成提示词，再到你使用的大模型中生成计划。</view>
 <view class="card form-card">
  <view wx:if="{{goals.length}}" class="field"><view class="field-label">使用已有目标</view><picker mode="selector" range="{{goals}}" range-key="title" value="{{goalIndex}}" bindchange="goalChange"><view class="picker-box row between"><text>{{goalId?goals[goalIndex].title:'自定义目标'}}</text><text class="chevron">⌄</text></view></picker></view>
  <view class="field"><view class="field-label">目标名称</view><input class="input" maxlength="30" placeholder="例如：12 月期末考试" value="{{title}}" data-field="title" bindinput="input"/></view>
  <view class="field"><view class="field-label">目标日期</view><picker mode="date" value="{{targetDate}}" start="{{today}}" bindchange="dateChange"><view class="picker-box row between"><text>{{targetDate||'选择日期'}}</text><text class="chevron">⌄</text></view></picker></view>
  <view class="field"><view class="field-label">安排科目</view><view class="chips"><text wx:for="{{subjects}}" wx:key="id" class="chip {{item.selected?'active':''}}" data-id="{{item.id}}" bindtap="toggleSubject">{{item.name}}</text></view></view>
  <view class="field"><view class="field-label">每天可学习 <text class="small muted">· 分钟</text></view><input class="input" type="number" maxlength="3" value="{{dailyMinutes}}" data-field="dailyMinutes" bindinput="input"/><view class="hint">按每天实际能安排的时间填写。</view></view>
  <view class="field"><view class="field-label">目前学习情况 <text class="small muted">· 选填</text></view><textarea class="textarea situation-input" maxlength="1000" placeholder="例如：已经学完哪些内容、哪些部分较薄弱、最近的进度" value="{{situation}}" data-field="situation" bindinput="input"></textarea></view>
 </view>
 <view class="hint privacy-note">提示词在本机生成，app 不会把这些信息发送到后端。你复制到的大模型会按其自身服务规则处理内容，请自行选择模型并避免填写敏感信息。</view>
 <button class="primary generate-button" bindtap="generate">生成提示词</button>
 <view wx:if="{{promptReady}}" class="prompt-section">
  <view class="section-head"><text>复制提示词到你使用的大模型</text><text class="small muted">可长按选择文本</text></view>
  <view class="card prompt-card"><text class="prompt-text" selectable="true">{{prompt}}</text></view>
  <button class="primary copy-button" bindtap="copyPrompt">复制提示词</button>
  <button class="plain-btn import-button" bindtap="openImport">生成完成后，粘贴计划并导入</button>
 </view>
 <view class="ai-result-section">
  <view class="section-head"><text>粘贴大模型生成的计划</text></view>
  <view class="hint preview-note">每行一个任务：任务名称 [科目] YYYY-MM-DD HH:mm 预计30分钟。一次最多 300 条。</view>
  <view class="card">
   <textarea class="import-area" data-field="text" maxlength="60000" placeholder="将生成的任务行粘贴到这里" value="{{text}}" bindinput="planInput"></textarea>
   <view class="parse-row row between"><text class="hint">{{lineCount ? lineCount+' 行内容' : '先填写上方目标与可用时间'}}</text><button class="primary parse-btn" bindtap="parse">检查计划</button></view>
  </view>
  <view wx:if="{{showPreview}}" class="preview-section">
   <view class="section-head"><text>检查与确认</text><text class="small muted">可导入 {{summary.importable}} · 待修正 {{summary.blocked}}</text></view>
   <view class="hint preview-note">检查日期、科目和预计用时；学习内容是否合适仍需你确认。重复、排除的任务不会导入。</view>
   <view wx:if="{{dailyLoads.length}}" class="card daily-loads">
    <view class="strong">每日预计负荷</view>
    <view wx:for="{{dailyLoads}}" wx:key="date" class="load-row {{item.overloaded?'danger-text':''}}">
     <view class="row between"><text>{{item.date}}</text><text>{{item.totalMinutes}} / {{dailyMinutes}} 分钟</text></view>
     <view class="hint">已有 {{item.existingMinutes}} + 本次 {{item.draftMinutes}} 分钟{{item.overloaded?' · 超出可用时间':''}}</view>
     <view wx:if="{{item.unknownCount}}" class="hint">另有 {{item.unknownCount}} 条任务未填预计时长，实际负荷可能更高。</view>
    </view>
   </view>
   <view class="card preview-card">
    <view wx:for="{{rows}}" wx:key="key" class="preview-row">
     <view wx:if="{{item.editing}}" class="preview-edit">
      <input class="input edit-input" maxlength="60" value="{{item.editTitle}}" bindinput="editTitle"/>
      <view class="edit-line">
       <picker mode="selector" range="{{subjectOptions}}" range-key="name" value="{{item.editSubjectIndex}}" bindchange="editSubject"><view class="picker-box">{{item.editSubjectName}}</view></picker>
       <picker mode="date" value="{{item.editDate}}" bindchange="editDate"><view class="picker-box">{{item.editDate}}</view></picker>
       <picker mode="time" value="{{item.editTime}}" bindchange="editTime"><view class="picker-box time-box">{{item.editTime}}</view></picker>
      </view>
      <view class="edit-duration"><text class="hint">预计时长（分钟）</text><input class="input minutes-input" type="number" value="{{item.editMinutes}}" bindinput="editMinutes" placeholder="例如 30"/></view>
      <view class="row edit-actions"><button size="mini" class="plain-btn" bindtap="cancelEdit">取消</button><button size="mini" class="plain-btn save-edit" bindtap="saveEdit">完成</button></view>
     </view>
     <view wx:else>
      <view class="row between"><view class="preview-title">{{item.title || '（没有任务名）'}}</view><text class="badge {{item.tone}}">{{item.badge}}</text></view>
      <view wx:if="{{item.metaText}}" class="hint">{{item.metaText}}</view>
      <view wx:if="{{item.reason}}" class="hint {{item.tone==='danger'?'danger-text':''}}">{{item.reason}}</view>
      <view class="row row-tools"><text class="link edit-row" data-index="{{index}}" bindtap="startEdit">编辑</text><text class="link exclude-row" data-index="{{index}}" bindtap="toggleExclude">{{item.excluded?'恢复':'排除'}}</text></view>
     </view>
    </view>
    <view wx:if="{{!rows.length}}" class="hint">没有解析到任务。</view>
   </view>
   <view wx:if="{{summary.blocked && !importDone}}" class="hint danger-text preview-note">请先修正或排除 {{summary.blocked}} 条任务，再确认导入。</view>
   <button wx:if="{{!importDone}}" class="primary confirm-plan" disabled="{{!summary.importable || summary.blocked || importing || editingPlan}}" bindtap="confirmImport">{{importing?'正在导入…':'确认导入 '+summary.importable+' 条'}}</button>
   <view wx:else class="import-success"><view class="strong">计划已导入</view><button class="primary view-plan" bindtap="viewPlan">查看计划</button></view>
  </view>
 </view>
</view>
