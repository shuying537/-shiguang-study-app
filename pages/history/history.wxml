<view class="screen {{theme}} history-page">
 <view class="eyebrow">YOUR STUDY HISTORY</view><view class="title">每一段，都算数。</view><view class="subtitle">按学习发生的日期，回看你的投入。</view>
 <view class="history-filters"><view class="chips"><text class="chip {{range==='all'?'active':''}}" data-range="all" bindtap="rangeChange">全部日期</text><text class="chip {{range==='week'?'active':''}}" data-range="week" bindtap="rangeChange">近 7 天</text><picker mode="date" value="{{selectedDate || today}}" end="{{today}}" bindchange="chooseDate"><view class="chip {{range==='date'?'active':''}}">{{selectedDate || '选择日期'}} ⌄</view></picker></view>
 <picker mode="selector" range="{{subjectOptions}}" range-key="name" value="{{subjectIndex}}" bindchange="subjectChange"><view class="picker-box row between"><text>{{subjectOptions[subjectIndex].name}}</text><text class="chevron">⌄</text></view></picker></view>
 <view class="section-head"><text class="history-summary">{{total}} 条记录 · {{totalText}}</text><text class="link" bindtap="record">＋ 补录</text></view>
 <view wx:for="{{groups}}" wx:for-item="group" wx:key="date" class="history-group"><view class="group-date">{{group.date}}</view><view class="card"><view wx:for="{{group.records}}" wx:key="id" class="list-row row between" data-id="{{item.id}}" bindtap="edit"><view class="history-record-body"><view class="row"><view class="dot" style="background:{{item.color}}"></view><text class="strong">{{item.subjectName}}</text><text wx:if="{{item.subjectDeleted}}" class="deleted-tag">已删除科目</text></view><view class="hint">{{item.note || '专注学习'}}<text wx:if="{{item.taskName}}"> · {{item.taskName}}</text></view></view><text class="history-duration">{{item.durationText}} ›</text></view></view></view>
 <view wx:if="{{!total}}" class="card empty"><view class="empty-title">这里还没有学习记录</view><view class="subtitle">换个筛选条件，或记下第一段学习。</view><button class="primary" bindtap="record">记录学习</button></view>
 <view wx:else class="hint history-end">{{shown < total?'向上滑动加载更多':'已展示全部记录'}}</view>
</view>
