.period-row{margin:30rpx 0}.period-switch{display:flex;background:var(--card);border-radius:18rpx;padding:6rpx}.period-option{padding:12rpx 24rpx;border-radius:14rpx;font-size:26rpx;color:var(--muted)}.period-option.selected{background:var(--soft);color:var(--accent);font-weight:600}.range-label{font-size:24rpx}.range-arrow{font-size:40rpx;padding:0 14rpx;color:var(--accent)}.metrics{margin-bottom:24rpx}.metric-number{font-size:34rpx}.unit{font-size:24rpx;margin-left:8rpx}.chart-title{font-size:29rpx;font-weight:600;margin-bottom:22rpx}.ring-canvas{width:270rpx;height:260rpx;flex-shrink:0}.legend{flex:1;min-width:0;padding-left:28rpx}.legend-item{margin:18rpx 0}.legend-name{font-size:24rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.legend-value{font-size:22rpx;margin-left:26rpx;margin-top:7rpx}.legend-value text{margin-left:10rpx}.trend-canvas{width:100%;height:320rpx}.bar-canvas{width:100%;height:280rpx}.mini-legend{display:flex;gap:20rpx;flex-wrap:wrap;font-size:21rpx;color:var(--muted)}.month-bar-item{margin:24rpx 0}.month-bar-track{background:var(--line);height:14rpx;border-radius:14rpx;margin-top:16rpx;overflow:hidden}.month-bar-fill{height:100%;border-radius:14rpx}.streak{text-align:right}.streak-note{margin:-6rpx 16rpx 24rpx}
.period-range{gap:0}.period-range .range-arrow{padding:0 10rpx}.range-label{font-size:23rpx}.average-note{margin:-6rpx 8rpx 28rpx}.completed-body{flex:1;min-width:0;margin-right:16rpx;word-break:break-all}.detail-duration{font-size:24rpx;color:var(--muted);flex-shrink:0}.history-link{margin:28rpx 0;font-size:26rpx}.stats-page .metric-number{font-size:30rpx}.stats-page .metric{min-width:0}.distribution .row{align-items:center}
