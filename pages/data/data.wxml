<view class="screen {{theme}} stats-page">
 <view class="eyebrow">LOOK BACK, MOVE FORWARD</view><view class="title">{{period==='week'?'本周学习反馈。':'月度学习反馈。'}}</view><view class="subtitle">时间来自实际记录，完成数来自任务勾选。</view>
 <view class="row between period-row"><view class="period-switch"><text class="period-option {{period==='week'?'selected':''}}" data-id="week" bindtap="period">周</text><text class="period-option {{period==='month'?'selected':''}}" data-id="month" bindtap="period">月</text></view><view class="row period-range"><text class="range-arrow" data-step="-1" bindtap="shift">‹</text><text class="range-label">{{rangeLabel}}</text><text class="range-arrow {{isCurrent?'muted':''}}" data-step="1" bindtap="shift">›</text></view></view>
 <view class="metrics"><view class="metric"><view class="metric-number">{{summary.totalText || '0分钟'}}</view><view class="metric-label">实际学习时长</view></view><view class="metric"><view class="metric-number">{{summary.activeDays || 0}}<text class="unit">天</text></view><view class="metric-label">学习天数</view></view></view>
 <view class="metrics"><view class="metric"><view class="metric-number">{{summary.averageText || '0分钟'}}</view><view class="metric-label">日均 · 除以 {{summary.averageDays}} 天</view></view><view class="metric"><view class="metric-number">{{summary.completedTasks || 0}}<text class="unit">项</text></view><view class="metric-label">实际完成任务</view></view></view>
 <view class="hint average-note">日均按完整周期计算，显示值四舍五入到分钟；本周固定除以 7。</view>
 <view class="card distribution"><view class="chart-title">科目时间分布</view><view class="row"><canvas id="ring" type="2d" class="ring-canvas"></canvas><view class="legend"><view wx:for="{{subjects}}" wx:key="id" class="legend-item"><view class="row"><view class="dot" style="background:{{item.color}}"></view><text class="legend-name">{{item.name}}</text></view><view class="legend-value">{{item.text}} <text class="muted">{{item.percent}}%</text></view></view><view wx:if="{{!subjects.length}}" class="subtitle">记录一段学习<br/>看看时间的去向</view></view></view></view>
 <view class="card"><view class="row between"><view class="chart-title">每日学习趋势</view><text class="small muted">分钟</text></view><canvas id="trend" type="2d" class="trend-canvas" bindtap="trendTap"></canvas><view class="hint">点击查看当天记录，未记录的日期按 0 计。</view></view>
 <view class="section-head"><text>完成的任务</text><text class="link" bindtap="plan">安排下一步 ›</text></view>
 <view class="card"><view wx:for="{{completed}}" wx:key="id" class="list-row row between" data-id="{{item.id}}" bindtap="taskDetail"><view class="completed-body"><view class="strong">{{item.title}}</view><view class="hint">{{item.subjectName}} · {{item.completedDate}} 完成</view></view><text class="chevron">›</text></view><view wx:if="{{!completed.length}}" class="hint">本周期还没有完成的任务，学习记录会独立计入时长。</view><view class="hint">按实际完成日期统计，取消完成后不计入。</view><view wx:if="{{legacyCompletedCount}}" class="hint">{{legacyCompletedCount}} 项旧版完成任务缺少完成日期，未计入周期完成数。</view></view>
 <view class="section-head"><text>学习明细</text><text class="link" bindtap="showAll">{{showDetails?'收起':'展开本周期'}} ›</text></view>
 <view wx:if="{{showDetails}}" class="card"><view wx:if="{{selectedDate}}" class="small muted">{{selectedDate}}</view><view wx:for="{{detailRecords}}" wx:key="id" class="list-row row between" data-id="{{item.id}}" bindtap="edit"><view class="completed-body"><view class="row strong"><view class="dot" style="background:{{item.color}}"></view>{{item.subjectName}}</view><view class="hint">{{item.date}} · {{item.note || '专注学习'}}</view></view><text class="detail-duration">{{item.durationText}} ›</text></view><view wx:if="{{!detailRecords.length}}" class="empty subtitle">这里没有学习记录。</view></view>
 <button class="secondary history-link" bindtap="history">查看全部历史记录 ›</button>
 <view wx:if="{{!records.length}}" class="card empty"><view class="empty-title">记下第一段学习</view><view class="subtitle">投入的每一分钟，都可以在这里回看。</view><button class="primary" bindtap="record">记录学习</button></view>
</view>

