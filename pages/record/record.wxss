.form-card{margin-top:30rpx}.duration-row{display:flex;align-items:center;background:var(--bg);border:2rpx solid var(--line);border-radius:18rpx;padding:0 24rpx}.duration-input{flex:1;border:0;background:transparent;padding:22rpx 0;min-height:84rpx;font-size:46rpx;font-weight:650}.duration-unit{color:var(--muted);font-size:25rpx}.quick-row{display:flex;gap:14rpx;margin-top:14rpx}.quick{flex:1;text-align:center;padding:14rpx 0;background:var(--soft);color:var(--accent);border-radius:14rpx;font-size:24rpx}.time-row{display:flex;align-items:center;gap:14rpx}.time-row picker{flex:1}.time-row .picker-box{text-align:center}.text-right{text-align:right}
.optional-toggle{font-size:24rpx;color:var(--accent);border-top:1rpx solid var(--line);padding:24rpx 0 8rpx;gap:14rpx}
