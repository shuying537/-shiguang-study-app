<view class="screen {{theme}} form-page">
 <view class="eyebrow">SAVE A MOMENT</view><view class="title">{{editing?'编辑学习记录':'补录学习'}}</view><view class="subtitle">{{editing?'选择科目和时长，就能留下学习记录。':'每科单独填写时长，保存时一起记入。'}}</view>
 <view class="card form-card">
  <view wx:if="{{editing}}" class="field"><view class="field-label">科目</view><picker mode="selector" range="{{subjects}}" range-key="name" value="{{subjectIndex}}" bindchange="subjectChange"><view class="picker-box row between"><text>{{subjectIndex < subjects.length ? subjects[subjectIndex].name : '请选择科目'}}</text><text class="chevron">⌄</text></view></picker><view class="hint link" bindtap="createSubject">＋ 新建科目</view></view>
  <view wx:else class="field batch-subjects">
   <view class="row between"><view class="field-label">补录科目 <text class="small muted">· {{recordRows.length}} 科</text></view><text class="link" data-action="add" bindtap="changeRows">＋ 添加科目</text></view>
   <view wx:for="{{recordRows}}" wx:key="key" class="batch-row">
    <view class="row between batch-row-head"><picker mode="selector" range="{{item.options}}" range-key="name" value="{{item.subjectIndex}}" data-index="{{index}}" bindchange="rowSubjectChange"><view class="picker-box batch-subject-picker row between"><text>{{item.options[item.subjectIndex].name}}</text><text class="chevron">⌄</text></view></picker><text wx:if="{{recordRows.length > 1}}" class="link batch-remove" data-action="remove" data-index="{{index}}" bindtap="changeRows">移除</text></view>
    <view class="duration-row"><input class="input duration-input" type="number" maxlength="4" placeholder="学习时长" value="{{item.duration}}" data-index="{{index}}" bindinput="rowDurationInput"/><text class="duration-unit">分钟</text></view>
    <view class="quick-row"><text wx:for="{{quickDurations}}" wx:for-item="minutes" wx:for-index="minuteIndex" wx:key="*this" class="quick" data-index="{{index}}" data-value="{{minutes}}" bindtap="rowQuickDuration">{{minutes>=60?minutes/60+'h':minutes+'m'}}</text></view>
   </view>
   <view class="hint">每个科目填写自己的时长；下方日期和备注应用于本次所有记录。</view>
   <view class="hint link" bindtap="createSubject">＋ 新建科目</view>
  </view>
  <view class="field"><view class="field-label">学习日期</view><picker mode="date" value="{{date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="dateChange"><view class="picker-box row between"><text>{{date}}</text><text class="chevron">⌄</text></view></picker><view class="hint">{{olderRecord?'这是一条历史记录，可以保留原日期修改；变更日期仍限最近 7 天。':'可补录今天及前 6 个自然日。'}}</view></view>
  <view wx:if="{{editing}}" class="field"><view class="field-label">学习时长 <text class="small muted">· 分钟</text></view><view class="duration-row"><input class="input duration-input" type="number" maxlength="4" placeholder="例如 30" value="{{duration}}" data-field="duration" bindinput="input"/><text class="duration-unit">分钟</text></view><view class="quick-row"><text wx:for="{{quickDurations}}" wx:key="*this" class="quick" data-value="{{item}}" bindtap="quickDuration">{{item>=60?item/60+'h':item+'m'}}</text></view><view class="hint">5–1440 分钟，按 5 分钟递增。</view></view>
  <view class="field"><view class="field-label">学习内容 <text class="small muted">· 选填</text></view><textarea class="textarea" maxlength="100" placeholder="例如：复习单词、完成第二章练习…" value="{{note}}" data-field="note" bindinput="input"></textarea></view>
  <view wx:if="{{editing || recordRows.length === 1}}" class="row between optional-toggle" bindtap="toggleDetails"><text>关联任务与起止时间（选填）</text><text>{{detailsExpanded?'⌃':'⌄'}}</text></view>
  <view wx:if="{{detailsExpanded}}">
   <view class="field"><view class="field-label">关联任务</view><picker mode="selector" range="{{taskOptions}}" range-key="title" value="{{taskIndex}}" bindchange="taskChange"><view class="picker-box row between"><text>{{taskIndex < taskOptions.length ? taskOptions[taskIndex].title : '不关联任务'}}</text><text class="chevron">⌄</text></view></picker></view>
   <view class="field"><view class="field-label">开始 / 结束时间</view><view class="time-row"><picker mode="time" value="{{startTime}}" bindchange="startChange"><view class="picker-box">{{startTime||'开始'}}</view></picker><text class="muted">至</text><picker mode="time" value="{{endTime}}" bindchange="endChange"><view class="picker-box">{{endTime||'结束'}}</view></picker></view><view class="hint">起止时间仅作参考，不参与时长计算。</view></view>
  </view>
 </view>
 <view class="footer-actions"><button wx:if="{{editing}}" class="danger" bindtap="remove">删除记录</button><button class="primary" disabled="{{loadError}}" bindtap="save">{{editing?'保存修改':'保存记录'}}</button></view>
</view>

