<view class="screen {{theme}} form-page">
 <view class="eyebrow">SAVE A MOMENT</view><view class="title">{{editing?'编辑学习记录':'记下一段学习'}}</view><view class="subtitle">选择科目和时长，就能留下学习记录。</view>
 <view class="card form-card">
  <view class="field"><view class="field-label">科目</view><picker mode="selector" range="{{subjects}}" range-key="name" value="{{subjectIndex}}" bindchange="subjectChange"><view class="picker-box row between"><text>{{subjects[subjectIndex].name}}</text><text class="chevron">⌄</text></view></picker><view class="hint link" bindtap="createSubject">＋ 新建科目</view></view>
  <view class="field"><view class="field-label">学习日期</view><picker mode="date" value="{{date}}" start="{{minDate}}" end="{{maxDate}}" bindchange="dateChange"><view class="picker-box row between"><text>{{date}}</text><text class="chevron">⌄</text></view></picker><view class="hint">{{olderRecord?'这是一条历史记录，可以保留原日期修改；变更日期仍限最近 7 天。':'可补录今天及前 6 个自然日。'}}</view></view>
  <view class="field"><view class="field-label">学习时长 <text class="small muted">· 分钟</text></view><view class="duration-row"><input class="input duration-input" type="number" maxlength="4" placeholder="例如 30" value="{{duration}}" data-field="duration" bindinput="input"/><text class="duration-unit">分钟</text></view><view class="quick-row"><text wx:for="{{quickDurations}}" wx:key="*this" class="quick" data-value="{{item}}" bindtap="quickDuration">{{item>=60?item/60+'h':item+'m'}}</text></view><view class="hint">5–1440 分钟，按 5 分钟递增。</view></view>
  <view class="field"><view class="field-label">学习内容 <text class="small muted">· 选填</text></view><textarea class="textarea" maxlength="100" placeholder="例如：复习单词、完成第二章练习…" value="{{note}}" data-field="note" bindinput="input"></textarea></view>
  <view class="row between optional-toggle" bindtap="toggleDetails"><text>关联任务与起止时间（选填）</text><text>{{detailsExpanded?'⌃':'⌄'}}</text></view>
  <view wx:if="{{detailsExpanded}}">
   <view class="field"><view class="field-label">关联任务</view><picker mode="selector" range="{{taskOptions}}" range-key="title" value="{{taskIndex}}" bindchange="taskChange"><view class="picker-box row between"><text>{{taskOptions[taskIndex].title}}</text><text class="chevron">⌄</text></view></picker></view>
   <view class="field"><view class="field-label">开始 / 结束时间</view><view class="time-row"><picker mode="time" value="{{startTime}}" bindchange="startChange"><view class="picker-box">{{startTime||'开始'}}</view></picker><text class="muted">至</text><picker mode="time" value="{{endTime}}" bindchange="endChange"><view class="picker-box">{{endTime||'结束'}}</view></picker></view><view class="hint">起止时间仅作参考，不参与时长计算。</view></view>
  </view>
 </view>
 <view class="footer-actions"><button wx:if="{{editing}}" class="danger" bindtap="remove">删除记录</button><button class="primary" disabled="{{loadError}}" bindtap="save">{{editing?'保存修改':'保存记录'}}</button></view>
</view>

