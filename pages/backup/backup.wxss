.backup-area{width:100%;height:300rpx;margin:20rpx 0;padding:22rpx;background:var(--bg);border:2rpx solid var(--line);border-radius:18rpx;font-size:23rpx;line-height:1.6;color:var(--muted)}
.import-area{color:var(--ink)}
.backup-actions{gap:16rpx;margin-bottom:10rpx}
.backup-actions button{flex:1;margin:0;line-height:78rpx;font-size:25rpx}
.file-pick{position:relative;margin:4rpx 0 18rpx}
.file-btn{text-align:center;line-height:78rpx;font-size:25rpx}
.file-input{position:absolute;left:0;top:0;width:100%;height:100%;opacity:0}
.backup-page .card .secondary,.backup-page .card .primary{margin-top:6rpx}
